{
 "cohort": "AllOfUs",
 "note": "Run inside the AoU Researcher Workbench (Controlled Tier). Fill the two FILL_FROM_DATA_DICTIONARY paths from 'How the All of Us Genomic data are organized' (SV VCF, ancestry_preds.tsv) for the CDR version of the workspace. Individual-level files stay on the persistent disk / workspace bucket; only export_dir content may leave, after the 1-20 small-cell rule.",
 "results_dir": "${HOME}/cnv_anthro_run/results",
 "export_dir": "${HOME}/cnv_anthro_run/export_aggregate",
 "min_cell": 20,
 "pheno_table": "${HOME}/cnv_anthro_run/data/aou_pheno_std.tsv",
 "cnv_table": "${HOME}/cnv_anthro_run/data/aou_srwgs_sv.cnv",
 "prep_commands": [
  [
   "aou_sv_to_cnv.py",
   "--vcf",
   "FILL_FROM_DATA_DICTIONARY:gs://.../sv/<joint-called SV vcf.gz>",
   "--out",
   "${HOME}/cnv_anthro_run/data/aou_srwgs_sv.cnv",
   "--write_samples",
   "${HOME}/cnv_anthro_run/data/sv_samples.txt",
   "--min_size",
   "10000",
   "--max_freq",
   "0.10",
   "--chroms",
   "1-22"
  ],
  [
   "aou_pheno_extract.py",
   "--ancestry",
   "FILL_FROM_DATA_DICTIONARY:gs://.../ancestry_preds.tsv (copy locally first)",
   "--keep_samples",
   "${HOME}/cnv_anthro_run/data/sv_samples.txt",
   "--out",
   "${HOME}/cnv_anthro_run/data/aou_pheno_std.tsv",
   "--summary",
   "${HOME}/cnv_anthro_run/results/aou_pheno_summary.json",
   "--n_pcs",
   "16"
  ]
 ],
