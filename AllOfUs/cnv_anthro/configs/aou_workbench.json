{
 "cohort": "AllOfUs",
 "note": "Run inside the AoU Researcher Workbench (Controlled Tier). Fill the two FILL_FROM_DATA_DICTIONARY paths from 'How the All of Us Genomic data are organized' (SV VCF, ancestry_preds.tsv) for the CDR version of the workspace. Individual-level files stay on the persistent disk / workspace bucket; only export_dir content may leave, after the 1-20 small-cell rule. Strata, loci and grid steps added 2026-11-15 for the UKBB+AoU meta-analysis; see HANDOFF_AoU_Milad.",
 "results_dir": "${HOME}/cnv_anthro_run/results",
 "export_dir": "${HOME}/cnv_anthro_run/export_aggregate",
